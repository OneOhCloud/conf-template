{
    "name": "conf-template",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Versioned sing-box config templates for OneBox, generated from region intent and validated with matching kernels.",
    "scripts": {
        "generate": "tsx scripts/generate.ts",
        "generate:strict": "tsx scripts/generate.ts --strict",
        "check": "tsx scripts/generate.ts --dry-run",
        "test": "tsx --test scripts/convention/generator/*.test.ts"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "jsonc-parser": "^3.3.1",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    }
}
